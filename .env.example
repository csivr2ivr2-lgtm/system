# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Spotify Developer API parameters
# Create a free Spotify developer application at https://developer.spotify.com/dashboard
# Add your Client ID and Client Secret in the Secrets panel in AI Studio.
SPOTIFY_CLIENT_ID=MY_SPOTIFY_CLIENT_ID
SPOTIFY_CLIENT_SECRET=MY_SPOTIFY_CLIENT_SECRET
SPOTIFY_REDIRECT_URI=jarvisassistant://spotify-callback